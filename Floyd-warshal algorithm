#include <iostream>
#include <vector>
#include <iomanip>

// Use a safe value for infinity to prevent integer overflow during addition
const int INF = 1e9; 

/**
 * Runs the Floyd-Warshall algorithm to find all-pairs shortest paths.
 * @param graph The adjacency matrix where graph[i][j] is the weight of the edge i -> j.
 *              Unreachable nodes should be marked with INF.
 */
void floydWarshall(std::vector<std::vector<int>>& graph) {
    int V = graph.size();
    
    // Create a distance matrix initialized with the given graph weights
    std::vector<std::vector<int>> dist = graph;

    // Core algorithm: Phase k treats vertex k as an intermediate point
    for (int k = 0; k < V; ++k) {
        for (int i = 0; i < V; ++i) {
            for (int j = 0; j < V; ++j) {
                // Ensure nodes i->k and k->j are reachable before updating
                if (dist[i][k] != INF && dist[k][j] != INF) {
                    dist[i][j] = std::min(dist[i][j], dist[i][k] + dist[k][j]);
                }
            }
        }
    }

    // Check for negative weight cycles
    for (int i = 0; i < V; ++i) {
        if (dist[i][i] < 0) {
            std::cout << "Error: Negative weight cycle detected in the graph!\n";
            return;
        }
    }

    // Print the final shortest path matrix
    std::cout << "Shortest distance matrix between every pair of vertices:\n";
    for (int i = 0; i < V; ++i) {
        for (int j = 0; j < V; ++j) {
            if (dist[i][j] == INF) {
                std::cout << std::setw(5) << "INF";
            } else {
                std::cout << std::setw(5) << dist[i][j];
            }
        }
        std::cout << "\n";
    }
}

int main() {
    /* Example Graph representation:
         (0)------3----->(1)

          |              / |
          5            2   4

          |          /     |
          v         v      v
         (3)<-----2------(2)
    */
    int V = 4;
    std::vector<std::vector<int>> graph = {
        {0, 3, INF, 5},
        {INF, 0, INF, 4},
        {INF, 1, 0, INF},
        {INF, INF, 2, 0}
    };

    floydWarshall(graph);

    return 0;
}
